{
  "name": "simple-http-rest-client",
  "version": "2.4.0",
  "description": "A lightweight framework for creating reliable REST HTTP clients in TypeScript",
  "author": "Aurélien Manteaux <amanteaux@coreoz.com> (https://coreoz.com)",
  "homepage": "https://github.com/Coreoz/simple-http-rest-client",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "http",
    "rest",
    "client",
    "api",
    "fetch",
    "typescript",
    "promise",
    "multipart"
  ],
  "scripts": {
    "build": "tsup",
    "typescript": "tsc --noEmit",
    "eslint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare-release": "yarn typescript && yarn eslint && yarn test && yarn build",
    "release": "release-it"
  },
  "release-it": {
    "npm": {
      "publish": false
    },
    "hooks": {
      "before:init": [
        "yarn prepare-release"
      ]
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "dependencies": {
    "simple-http-request-builder": "^2.1.0",
    "simple-logging-system": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^5.16.0",
    "@typescript-eslint/parser": "^5.16.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "release-it": "^15.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Coreoz/simple-http-rest-client"
  },
  "bugs": {
    "url": "https://github.com/Coreoz/simple-http-rest-client/issues"
  },
  "packageManager": "yarn@4.18.0"
}
